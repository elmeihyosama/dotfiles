---
# Copy to ansible/local.yml (git-ignored) and edit per machine.
git_name: "Your Name"
git_email: "you@example.com"
# Optional identity for the repos below (both set → an includeIf in
# ~/.config/git/config). Prefer GitHub's noreply form.
# personal_git_name: "yourhandle"
# personal_git_email: "12345678+yourhandle@users.noreply.github.com"
# Directories (trailing slash = everything beneath); default in
# home/.chezmoidata/git.toml.
# personal_git_dirs: ["~/workspace/dotfiles/", "~/personal/"]
# allow_sudo: false     # default: auto-detected via `sudo -n true`
# shared_home: false    # true ONLY when one $HOME is shared across CPU arches:
#                       # binaries then go to ~/.local/bin-<arch> etc.

# Tool selection (catalog: home/.chezmoidata/tools.yaml). `core` is always
# installed; with none of these keys, every group is. Only `dotfiles remove`
# uninstalls (mise tools; native ones get a command).
# tool_groups: [git, dev]          # core + these groups (valid: git, files,
#                                  #   containers, system, media, dev)
# tools_add: [lazydocker]          # extra tools on top of the groups
# tools_remove: [gh-dash]          # tools to skip (core tools cannot be removed)
