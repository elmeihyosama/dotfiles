# Enforced by editorconfig-checker (exclusions in .editorconfig-checker.json).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Tabs, as shfmt.
[*.sh]
indent_style = tab

[*.sh.tmpl]
indent_style = tab

# Preserve Markdown trailing-space line breaks.
[*.md]
trim_trailing_whitespace = false
