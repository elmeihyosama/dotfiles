# https://editorconfig.org — enforced by editorconfig-checker in CI + pre-commit
# (a few files with intentional alignment are excluded in .editorconfig-checker.json).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Shell scripts use tabs (matches shfmt, enforced in CI).
[*.sh]
indent_style = tab

# Preserve Markdown trailing-space line breaks.
[*.md]
trim_trailing_whitespace = false
