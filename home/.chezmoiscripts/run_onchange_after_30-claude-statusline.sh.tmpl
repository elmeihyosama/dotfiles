#!/usr/bin/env bash
# Wire the statusline into each Claude account profile's settings.json (see
# claude.toml). It holds machine-local keys too, so jq-merge only statusLine.
set -euo pipefail
for dir in {{ range $i, $p := .claude_profiles }}{{ if $i }} "$HOME/.claude-{{ $p }}"{{ else }}"$HOME/.claude"{{ end }}{{ end }}; do
	settings="$dir/settings.json"
	mkdir -p "$dir"
	[ -f "$settings" ] || printf '{}\n' >"$settings"
	tmp="$(mktemp)"
	jq --arg cmd "$HOME/.claude/statusline.sh" \
		'.statusLine = {type: "command", command: $cmd}' "$settings" >"$tmp"
	mv "$tmp" "$settings"
done
