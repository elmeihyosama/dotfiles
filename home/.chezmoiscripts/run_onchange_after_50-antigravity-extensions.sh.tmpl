#!/bin/sh
# Install missing Antigravity extensions from the managed list (re-runs when
# its hash below changes). No-op without the CLI. Failures are non-fatal: Open
# VSX lacks some MS-licensed extensions.
# extensions.txt sha256: {{ include "dot_config/antigravity-ide/extensions.txt" | sha256sum }}
set -eu
command -v antigravity-ide >/dev/null 2>&1 || exit 0
ext_file="$HOME/.config/antigravity-ide/extensions.txt"
[ -f "$ext_file" ] || exit 0
# Un-piped: a failing CLI must abort here (set -e), not look like an empty list.
installed="$(antigravity-ide --list-extensions)"
installed="$(printf '%s\n' "$installed" | tr '[:upper:]' '[:lower:]')"
while IFS= read -r ext; do
	case "$ext" in '' | '#'*) continue ;; esac
	# -F: extension ids contain dots, which plain grep treats as wildcards.
	if ! printf '%s\n' "$installed" | grep -qiFx "$ext"; then
		antigravity-ide --install-extension "$ext" || echo "skip (unavailable): $ext"
	fi
done <"$ext_file"
