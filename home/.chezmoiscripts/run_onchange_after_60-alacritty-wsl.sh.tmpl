#!/bin/sh
# Sync the rendered Alacritty palette to the Windows side of a WSL install:
# Alacritty on Windows reads %APPDATA%\alacritty\, outside chezmoi's tree, so
# `theme` could never repaint it.
#
# run_onchange: the palette is embedded so a theme switch retriggers this.
# theme: {{ .theme }}
# palette: {{ (index .themes .theme) | toJson }}
set -eu

# WSL only — a no-op everywhere else.
grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null || exit 0
command -v wslpath >/dev/null 2>&1 || exit 0

src="$HOME/.config/alacritty/colors.toml"
[ -f "$src" ] || exit 0

# cmd.exe warns and falls back to C:\Windows when its cwd is a Linux path, so
# run it from /mnt/c. Output is CRLF-terminated.
appdata_win=$(cd /mnt/c 2>/dev/null && cmd.exe /c "echo %APPDATA%" 2>/dev/null | tr -d '\r\n') || exit 0
[ -n "$appdata_win" ] || exit 0

dest_dir="$(wslpath -u "$appdata_win")/alacritty"
# Absent means Alacritty isn't set up on the Windows side — nothing to paint.
[ -d "$dest_dir" ] || exit 0

cp -f "$src" "$dest_dir/colors.toml"
echo "alacritty: synced {{ .theme }} palette to $dest_dir/colors.toml"

# Alacritty never loads colors.toml on its own. Create a minimal Windows-side
# alacritty.toml (absolute import + this distro as shell) only if none exists;
# an existing one is the user's — only check it for the import.
cfg="$dest_dir/alacritty.toml"
if [ ! -f "$cfg" ]; then
	distro=${WSL_DISTRO_NAME:-}
	# printf, not echo: dash's echo would treat \a and \c in the path as escapes.
	{
		printf '%s\n' \
			"# Created once by dotfiles (.chezmoiscripts/run_onchange_after_60-alacritty-wsl.sh);" \
			"# yours to edit. Only colors.toml next to it is regenerated on theme switch." \
			"[general]" \
			"import = ['$appdata_win\\alacritty\\colors.toml']"
		if [ -n "$distro" ]; then
			printf '%s\n' "" "[terminal.shell]" 'program = "wsl.exe"' \
				"args = [\"-d\", \"$distro\", \"--cd\", \"~\"]"
		fi
	} >"$cfg"
	printf '%s\n' "alacritty: created $cfg (imports colors.toml${distro:+, opens $distro})"
elif ! grep -q 'colors\.toml' "$cfg"; then
	printf '%s\n' "alacritty: $cfg does not import colors.toml — add to it:" \
		"  [general]" "  import = ['$appdata_win\\alacritty\\colors.toml']" >&2
fi
