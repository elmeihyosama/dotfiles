# mise reads the dotfiles pins/lock from here (bash never reads .zshenv).
export MISE_SYSTEM_CONFIG_DIR="$HOME/.config/mise-dotfiles"
# mise shims first, before the interactive guard: non-interactive bash over
# ssh (`ssh host cmd`) reads this file too, and the CLI tools are mise tools.
{{ if .shared_home -}}
_mise_shims="$HOME/.local/share-$(uname -m)/mise/shims"
{{- else -}}
_mise_shims="${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims"
{{- end }}
if [ -d "$_mise_shims" ]; then
  PATH=":$PATH:"
  PATH="${PATH//:$_mise_shims:/:}"
  PATH="${PATH#:}"
  PATH="$_mise_shims:${PATH%:}"
  export PATH
fi
unset _mise_shims
# Standard bashrc head (interactive guard)
case $- in *i*) ;; *) return ;; esac
{{ if not (.allow_sudo | default false) }}
# No-sudo machines: login shell can't be changed to zsh → jump into it once.
# zsh itself is user-local (~/.local/bin), which a fresh login PATH doesn't
# have yet — prepend it here or `command -v zsh` never finds it.
# Escape hatch: `NO_ZSH_JUMP=1 bash` to stay in bash (e.g. to debug).
[[ -d "$HOME/.local/bin" && ":$PATH:" != *":$HOME/.local/bin:"* ]] && PATH="$HOME/.local/bin:$PATH"
{{ if .shared_home -}}
# On a shared-$HOME multi-arch host, zsh lives in the per-arch dir, not plain
# ~/.local/bin — add it too so the jump below can find it (no-op if absent).
[[ -d "$HOME/.local/bin-$(uname -m)" && ":$PATH:" != *":$HOME/.local/bin-$(uname -m):"* ]] && PATH="$HOME/.local/bin-$(uname -m):$PATH"
{{ end -}}
if [[ -z "${NO_ZSH_JUMP:-}" && -z "$ZSH_VERSION" ]] && command -v zsh >/dev/null 2>&1; then
  exec zsh -l
fi
{{ end -}}
