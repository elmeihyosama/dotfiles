# Runs for every zsh (incl. non-interactive). Keep MINIMAL — only ensure mise
# shims resolve project runtimes in non-interactive/child contexts (interactive
# shells get the richer dynamic `mise activate` in conf.d/49-mise.zsh).
{{ if .shared_home -}}
# Shared-$HOME multi-arch host: mise's data dir is per-arch (see 00-env.zsh),
# so its shims live under ~/.local/share-$(uname -m). $(uname -m) resolves per
# login host, keeping one rendered file correct on every arch.
_mise_shims="$HOME/.local/share-$(uname -m)/mise/shims"
{{ else -}}
_mise_shims="${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims"
{{ end -}}
# Always FIRST, even when an inherited PATH already has it further back (a
# nested shell under one that put ~/.local/bin or Homebrew ahead): the
# dotfiles' pinned tools must win. conf.d/00-env re-applies this after its own
# prepends.
if [[ -d $_mise_shims ]]; then
  path=("$_mise_shims" ${path:#$_mise_shims})
  export PATH
fi
unset _mise_shims

# The dotfiles' pinned mise tools (and their lock) live here, apart from the
# user's own ~/.config/mise/config.toml. Set for every zsh so shims resolve.
export MISE_SYSTEM_CONFIG_DIR="$HOME/.config/mise-dotfiles"
