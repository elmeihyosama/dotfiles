# Every zsh, including non-interactive: keep MINIMAL, just make mise shims
# resolve (interactive shells get `mise activate` in conf.d/49-mise.zsh).
{{ if .shared_home -}}
# Shared-$HOME multi-arch host: shims are per-arch; $(uname -m) resolves per
# login host.
_mise_shims="$HOME/.local/share-$(uname -m)/mise/shims"
{{ else -}}
_mise_shims="${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims"
{{ end -}}
# Always FIRST, even if an inherited PATH has them further back: the pinned
# tools must win. conf.d/00-env re-applies this after its prepends.
if [[ -d $_mise_shims ]]; then
  path=("$_mise_shims" ${path:#$_mise_shims})
  export PATH
fi
unset _mise_shims

# The dotfiles' pinned tools and lock, apart from the user's own mise config.
export MISE_SYSTEM_CONFIG_DIR="$HOME/.config/mise-dotfiles"
