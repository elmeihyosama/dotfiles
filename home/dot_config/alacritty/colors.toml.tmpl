{{- $p := index .themes .theme -}}
# Generated by chezmoi from the active base16 palette ({{ .theme }}) — do not edit.
#
# Alacritty is the one terminal in this stack that can live on the *Windows*
# side of a WSL install, where %APPDATA% is outside chezmoi's tree and
# `chezmoi apply` can never reach it. alacritty.toml imports this file; on WSL
# .chezmoiscripts/run_onchange_after_60-alacritty-wsl.sh copies it across after
# every apply, so `theme` repaints Alacritty like everything else.
#
# Import order matters: the importing file's values WIN over imported ones, so
# alacritty.toml must not define [colors] of its own.

[colors.primary]
background = "{{ $p.base00 }}"
foreground = "{{ $p.base05 }}"

[colors.cursor]
cursor = "{{ $p.base05 }}"
text   = "{{ $p.base00 }}"

[colors.selection]
background = "{{ $p.base02 }}"
text       = "{{ $p.base05 }}"

# palette 0-15 (standard base16 → ANSI mapping, identical to ghostty/config.tmpl)
[colors.normal]
black   = "{{ $p.base00 }}"
red     = "{{ $p.base08 }}"
green   = "{{ $p.base0B }}"
yellow  = "{{ $p.base0A }}"
blue    = "{{ $p.base0D }}"
magenta = "{{ $p.base0E }}"
cyan    = "{{ $p.base0C }}"
white   = "{{ $p.base05 }}"

[colors.bright]
black   = "{{ $p.base03 }}"
red     = "{{ $p.base08 }}"
green   = "{{ $p.base0B }}"
yellow  = "{{ $p.base0A }}"
blue    = "{{ $p.base0D }}"
magenta = "{{ $p.base0E }}"
cyan    = "{{ $p.base0C }}"
white   = "{{ $p.base07 }}"
