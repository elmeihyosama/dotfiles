{{- $p := index .themes .theme -}}
# Generated by chezmoi from the active base16 palette ({{ .theme }}) — do not edit.
# Imported by alacritty.toml; on WSL, .chezmoiscripts/run_onchange_after_60-alacritty-wsl.sh
# copies it to %APPDATA%\alacritty\ so `theme` repaints Alacritty too.

[colors.primary]
background = "{{ $p.base00 }}"
foreground = "{{ $p.base05 }}"

[colors.cursor]
cursor = "{{ $p.base05 }}"
text   = "{{ $p.base00 }}"

[colors.selection]
background = "{{ $p.base02 }}"
text       = "{{ $p.base05 }}"

# palette 0-15 (standard base16 → ANSI mapping, identical to ghostty/config.tmpl)
[colors.normal]
black   = "{{ $p.base00 }}"
red     = "{{ $p.base08 }}"
green   = "{{ $p.base0B }}"
yellow  = "{{ $p.base0A }}"
blue    = "{{ $p.base0D }}"
magenta = "{{ $p.base0E }}"
cyan    = "{{ $p.base0C }}"
white   = "{{ $p.base05 }}"

[colors.bright]
black   = "{{ $p.base03 }}"
red     = "{{ $p.base08 }}"
green   = "{{ $p.base0B }}"
yellow  = "{{ $p.base0A }}"
blue    = "{{ $p.base0D }}"
magenta = "{{ $p.base0E }}"
cyan    = "{{ $p.base0C }}"
white   = "{{ $p.base07 }}"
