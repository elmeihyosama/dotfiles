# Generated by chezmoi — do not edit. Font from home/.chezmoidata/font.toml.
# The palette is a separate import so the WSL sync script can copy just that
# file to the Windows side. Values here win over imported ones, so never set
# [colors] in this file. `[general].import` needs Alacritty >= 0.14.
[general]
import = ["~/.config/alacritty/colors.toml"]

[font]
size = {{ .font.size }}

[font.normal]
family = "{{ .font.family }}"
