# Generated by chezmoi — do not edit. Font comes from home/.chezmoidata/font.toml.
#
# The palette lives in colors.toml (imported below) rather than here so that
# .chezmoiscripts/run_onchange_after_60-alacritty-wsl.sh can copy just that one
# file to the Windows side of a WSL install without touching the Windows-side
# alacritty.toml. Alacritty never loads colors.toml on its own: without this
# import (or the one the WSL script writes) the palette is inert.
#
# Import order matters: values in THIS file win over imported ones, so [colors]
# must never be set here. `[general].import` needs Alacritty >= 0.14 (older
# releases take a top-level `import = [...]` instead).
[general]
import = ["~/.config/alacritty/colors.toml"]

[font]
size = {{ .font.size }}

[font.normal]
family = "{{ .font.family }}"
