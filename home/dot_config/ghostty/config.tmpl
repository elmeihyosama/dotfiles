{{- $p := index .themes .theme -}}
font-family = {{ .font.family }}
font-size = {{ .font.size }}
background-opacity = 0.8
background-blur = 20
clipboard-write = allow
copy-on-select = clipboard
{{- /* Wallpaper pairing: themed background-image when the active theme has a
  map entry in .chezmoidata/wallpaper.toml AND machine-local `wallpaper_mode`
  is not "off" (absent = on). Unmapped/off → solid base00 background below. */ -}}
{{- $mode := "on" -}}
{{- if hasKey . "wallpaper_mode" }}{{ $mode = .wallpaper_mode }}{{ end -}}
{{- $wp := "" -}}
{{- if ne $mode "off" }}{{ $wp = index $.wallpaper.map $.theme }}{{ end -}}
{{- if $wp }}
background-image = {{ $.chezmoi.homeDir }}/.config/wallpapers/{{ $wp }}
background-image-opacity = {{ $.wallpaper.opacity }}
background-image-fit = {{ $.wallpaper.fit }}
background-image-position = {{ $.wallpaper.position }}
{{- end }}

# Colors from the active base16 palette ({{ .theme }})
background = {{ $p.base00 }}
foreground = {{ $p.base05 }}
cursor-color = {{ $p.base05 }}
selection-background = {{ $p.base02 }}
selection-foreground = {{ $p.base05 }}

# palette 0-15 (standard base16 → ANSI mapping)
palette = 0={{ $p.base00 }}
palette = 1={{ $p.base08 }}
palette = 2={{ $p.base0B }}
palette = 3={{ $p.base0A }}
palette = 4={{ $p.base0D }}
palette = 5={{ $p.base0E }}
palette = 6={{ $p.base0C }}
palette = 7={{ $p.base05 }}
palette = 8={{ $p.base03 }}
palette = 9={{ $p.base08 }}
palette = 10={{ $p.base0B }}
palette = 11={{ $p.base0A }}
palette = 12={{ $p.base0D }}
palette = 13={{ $p.base0E }}
palette = 14={{ $p.base0C }}
palette = 15={{ $p.base07 }}
