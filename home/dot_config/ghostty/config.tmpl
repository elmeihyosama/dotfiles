{{- $p := index .themes .theme -}}
font-family = {{ .font.family }}
font-size = {{ .font.size }}
{{- /* Level from machine-local `glass` (absent/unknown = default); see glass.toml. */ -}}
{{- $g := "default" -}}
{{- if and (hasKey . "glass") (hasKey .glass_levels .glass) }}{{ $g = .glass }}{{ end -}}
{{- $lv := index .glass_levels $g }}
background-opacity = {{ $lv.opacity }}
background-blur = {{ $lv.blur }}
clipboard-write = allow
copy-on-select = clipboard
{{- /* Background image when the theme has a wallpaper.toml entry and
  machine-local `wallpaper_mode` is not "off" (absent = on). */ -}}
{{- $mode := "on" -}}
{{- if hasKey . "wallpaper_mode" }}{{ $mode = .wallpaper_mode }}{{ end -}}
{{- $wp := "" -}}
{{- if ne $mode "off" }}{{ $wp = index $.wallpaper.map $.theme }}{{ end -}}
{{- if $wp }}
background-image = {{ $.chezmoi.homeDir }}/.config/wallpapers/{{ $wp }}
background-image-opacity = {{ $.wallpaper.opacity }}
background-image-fit = {{ $.wallpaper.fit }}
background-image-position = {{ $.wallpaper.position }}
{{- end }}

# Colors from the active base16 palette ({{ .theme }})
background = {{ $p.base00 }}
foreground = {{ $p.base05 }}
cursor-color = {{ $p.base05 }}
selection-background = {{ $p.base02 }}
selection-foreground = {{ $p.base05 }}

# palette 0-15 (standard base16 → ANSI mapping)
palette = 0={{ $p.base00 }}
palette = 1={{ $p.base08 }}
palette = 2={{ $p.base0B }}
palette = 3={{ $p.base0A }}
palette = 4={{ $p.base0D }}
palette = 5={{ $p.base0E }}
palette = 6={{ $p.base0C }}
palette = 7={{ $p.base05 }}
palette = 8={{ $p.base03 }}
palette = 9={{ $p.base08 }}
palette = 10={{ $p.base0B }}
palette = 11={{ $p.base0A }}
palette = 12={{ $p.base0D }}
palette = 13={{ $p.base0E }}
palette = 14={{ $p.base0C }}
palette = 15={{ $p.base07 }}
