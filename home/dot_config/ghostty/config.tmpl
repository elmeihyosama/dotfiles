{{- $p := index .themes .theme -}}
font-family = {{ .font.family }}
font-size = {{ .font.size }}
background-opacity = 0.95

# Rosé Pine Moon (raw hex from palette)
background = {{ $p.base }}
foreground = {{ $p.text }}
cursor-color = {{ $p.text }}
selection-background = {{ $p.highlight_med }}
selection-foreground = {{ $p.text }}

# palette 0-15
palette = 0={{ $p.overlay }}
palette = 1={{ $p.love }}
palette = 2={{ $p.pine }}
palette = 3={{ $p.gold }}
palette = 4={{ $p.foam }}
palette = 5={{ $p.iris }}
palette = 6={{ $p.rose }}
palette = 7={{ $p.text }}
palette = 8={{ $p.muted }}
palette = 9={{ $p.love }}
palette = 10={{ $p.pine }}
palette = 11={{ $p.gold }}
palette = 12={{ $p.foam }}
palette = 13={{ $p.iris }}
palette = 14={{ $p.rose }}
palette = 15={{ $p.subtle }}
