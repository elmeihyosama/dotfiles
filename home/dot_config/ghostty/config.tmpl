{{- $p := index .themes .theme -}}
font-family = {{ .font.family }}
font-size = {{ .font.size }}
# Translucency: e.g. background-opacity = 0.85 and background-blur = 20
# (macos-glass-regular on macOS 26+).
background-opacity = 1.0
background-blur = false
clipboard-write = allow
copy-on-select = clipboard
# Cursor: Ghostty's shell integration draws a blinking bar at the prompt.
# For another shape: cursor-style = block|underline, cursor-style-blink =
# false, and shell-integration-features = no-cursor.

# Colors from the active base16 palette ({{ .theme }})
background = {{ $p.base00 }}
foreground = {{ $p.base05 }}
cursor-color = {{ $p.base05 }}
selection-background = {{ $p.base02 }}
selection-foreground = {{ $p.base05 }}

# palette 0-15 (standard base16 → ANSI mapping)
palette = 0={{ $p.base00 }}
palette = 1={{ $p.base08 }}
palette = 2={{ $p.base0B }}
palette = 3={{ $p.base0A }}
palette = 4={{ $p.base0D }}
palette = 5={{ $p.base0E }}
palette = 6={{ $p.base0C }}
palette = 7={{ $p.base05 }}
palette = 8={{ $p.base03 }}
palette = 9={{ $p.base08 }}
palette = 10={{ $p.base0B }}
palette = 11={{ $p.base0A }}
palette = 12={{ $p.base0D }}
palette = 13={{ $p.base0E }}
palette = 14={{ $p.base0C }}
palette = 15={{ $p.base07 }}
