{{- $p := index .themes .theme -}}
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "padding": { "top": 1, "right": 3 },
    // stripe the builtin logo's colour slots through the accent spectrum
    "color": {
      "1": "{{ $p.base08 }}", "2": "{{ $p.base09 }}", "3": "{{ $p.base0A }}",
      "4": "{{ $p.base0B }}", "5": "{{ $p.base0C }}", "6": "{{ $p.base0D }}"
    }
  },
  "display": { "separator": "  " },
  "modules": [
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}", "color": { "host": "{{ index $p .design.err }}" } },
    { "type": "custom", "format": "󰣀 ssh session", "outputColor": "{{ index $p .design.err }}" },
    "separator",
    { "type": "os", "key": "󰍹 os", "keyColor": "{{ index $p .design.accent2 }}" },
    { "type": "command", "key": "󰆍 term", "text": "printf '%s' \"${TERM_PROGRAM:-unknown}${TERM_PROGRAM_VERSION:+ ${TERM_PROGRAM_VERSION%%-*}}\"", "keyColor": "{{ index $p .design.accent2 }}" },
    { "type": "command", "key": "󰕮 mux", "text": "if [ -n \"$ZELLIJ\" ]; then printf zellij; else printf none; fi", "keyColor": "{{ index $p .design.accent2 }}" },
    { "type": "shell", "key": "󱆃 shell", "keyColor": "{{ index $p .design.accent2 }}" },
    { "type": "editor", "key": "󰏫 editor", "keyColor": "{{ index $p .design.accent2 }}" },
    { "type": "custom", "key": "󰏘 theme", "format": "{{ .theme }}", "keyColor": "{{ index $p .design.accent2 }}" },
    "separator",
    { "type": "cpu", "key": "󰘚 cpu", "keyColor": "{{ index $p .design.accent2 }}" },
    { "type": "gpu", "key": "󰢮 gpu", "keyColor": "{{ index $p .design.accent2 }}" },
    { "type": "memory", "key": "󰍛 memory", "keyColor": "{{ index $p .design.accent2 }}" },
    { "type": "uptime", "key": "󰅐 uptime", "keyColor": "{{ index $p .design.accent2 }}" },
    "break",
    "colors"
  ]
}
