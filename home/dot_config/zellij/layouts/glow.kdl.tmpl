{{- $p := index .themes .theme -}}
{{- $accent := index $p .design.accent -}}
{{- $warn := index $p .design.warn -}}
{{- $bar := $p.base01 -}}
{{- $overlay := $p.base02 -}}
{{- $muted := $p.base03 -}}
{{- $subtle := $p.base04 -}}
{{- $text := $p.base05 -}}
{{- $bg := $p.base00 -}}
{{- /* zjstatus's WASM sandbox can't read the system tz, and "local" is not a
valid chrono-tz name (it silently falls back to UTC). Resolve the real
IANA zone at render time from the /etc/localtime symlink — macOS points
into /var/db/timezone/zoneinfo/, Linux into /usr/share/zoneinfo/. */ -}}
{{- $tzlink := trim (output "sh" "-c" "readlink /etc/localtime || echo UTC") -}}
{{- $tz := regexReplaceAll `^.*zoneinfo(?:\.default)?/` $tzlink "" -}}
{{- if not $tz }}{{ $tz = "UTC" }}{{ end -}}
// Glow layout: top zjstatus bar (session pill, numbered pill tabs, muted
// date/time) with pane frames off. Escape hatch: `zellij -l split` for the
// stock two-pane layout with the compact bar.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="file:{{ .chezmoi.homeDir }}/.config/zellij/plugins/zjstatus.wasm" {
                format_left   "{mode}#[fg={{ $text }},bg={{ $accent }},bold] {session} #[fg={{ $accent }},bg={{ $bar }}]{tabs}"
                format_right  "{datetime}"
                format_space  "#[bg={{ $bar }}]"
                border_enabled "false"

                datetime          "#[fg={{ $muted }},bg={{ $bar }}]󰃭 {format} "
                datetime_format   "%b %d · %H:%M"
                datetime_timezone "{{ $tz }}"

                tab_normal    "#[fg={{ $overlay }},bg={{ $bar }}]#[fg={{ $subtle }},bg={{ $overlay }}]{index} {name}#[fg={{ $overlay }},bg={{ $bar }}] "
                tab_active    "#[fg={{ $accent }},bg={{ $bar }}]#[fg={{ $text }},bg={{ $accent }},bold]{index} {name}#[fg={{ $accent }},bg={{ $bar }}] "

                // NOTE: `{session}` is its own top-level widget (src/widgets/session.rs) — it
                // is NOT a substitution variable inside mode_* strings (only `{name}`, the mode
                // name, is). The session pill above is therefore composed directly in
                // format_left with a static accent style; mode_normal/mode_locked below render
                // only a small colour-coded icon chip immediately to its left, which is what
                // actually recolours per mode.
                mode_normal        "#[fg={{ $accent }},bg={{ $bar }}]#[fg={{ $text }},bg={{ $accent }},bold]󱂬 #[fg={{ $accent }},bg={{ $bar }}] "
                mode_locked        "#[fg={{ $muted }},bg={{ $bar }}]#[fg={{ $bg }},bg={{ $muted }},bold]󱂬 #[fg={{ $muted }},bg={{ $bar }}] "
                mode_pane          "#[fg={{ $warn }},bg={{ $bar }}]#[fg={{ $bg }},bg={{ $warn }},bold]󱂬 {name}#[fg={{ $warn }},bg={{ $bar }}] "
                mode_tab           "#[fg={{ $warn }},bg={{ $bar }}]#[fg={{ $bg }},bg={{ $warn }},bold]󱂬 {name}#[fg={{ $warn }},bg={{ $bar }}] "
                mode_resize        "#[fg={{ $warn }},bg={{ $bar }}]#[fg={{ $bg }},bg={{ $warn }},bold]󱂬 {name}#[fg={{ $warn }},bg={{ $bar }}] "
                mode_scroll        "#[fg={{ $warn }},bg={{ $bar }}]#[fg={{ $bg }},bg={{ $warn }},bold]󱂬 {name}#[fg={{ $warn }},bg={{ $bar }}] "
                mode_enter_search  "#[fg={{ $warn }},bg={{ $bar }}]#[fg={{ $bg }},bg={{ $warn }},bold]󱂬 {name}#[fg={{ $warn }},bg={{ $bar }}] "
                mode_search        "#[fg={{ $warn }},bg={{ $bar }}]#[fg={{ $bg }},bg={{ $warn }},bold]󱂬 {name}#[fg={{ $warn }},bg={{ $bar }}] "
                mode_rename_tab    "#[fg={{ $warn }},bg={{ $bar }}]#[fg={{ $bg }},bg={{ $warn }},bold]󱂬 {name}#[fg={{ $warn }},bg={{ $bar }}] "
                mode_rename_pane   "#[fg={{ $warn }},bg={{ $bar }}]#[fg={{ $bg }},bg={{ $warn }},bold]󱂬 {name}#[fg={{ $warn }},bg={{ $bar }}] "
                mode_session       "#[fg={{ $warn }},bg={{ $bar }}]#[fg={{ $bg }},bg={{ $warn }},bold]󱂬 {name}#[fg={{ $warn }},bg={{ $bar }}] "
                mode_move          "#[fg={{ $warn }},bg={{ $bar }}]#[fg={{ $bg }},bg={{ $warn }},bold]󱂬 {name}#[fg={{ $warn }},bg={{ $bar }}] "
                mode_prompt        "#[fg={{ $warn }},bg={{ $bar }}]#[fg={{ $bg }},bg={{ $warn }},bold]󱂬 {name}#[fg={{ $warn }},bg={{ $bar }}] "
                mode_tmux          "#[fg={{ $warn }},bg={{ $bar }}]#[fg={{ $bg }},bg={{ $warn }},bold]󱂬 {name}#[fg={{ $warn }},bg={{ $bar }}] "
                mode_default_to_mode "pane"
            }
        }
        children
    }
    tab name="main"
}
