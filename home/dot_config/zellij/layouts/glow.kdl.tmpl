{{- $p := index .themes .theme -}}
{{- $accent := index $p .design.accent -}}
{{- $warn := index $p .design.warn -}}
{{- $bar := $p.base01 -}}
{{- $overlay := $p.base02 -}}
{{- $muted := $p.base03 -}}
{{- $subtle := $p.base04 -}}
{{- $text := $p.base05 -}}
{{- $bg := $p.base00 -}}
{{- /* Chip foreground (scripts/gen-on-colors.sh): base00 alone fails on pastels. */ -}}
{{- $on := index .on_colors .theme -}}
{{- $onaccent := index $on .design.accent -}}
{{- $onwarn := index $on .design.warn -}}
{{- /* zjstatus's WASM sandbox can't read the system tz and "local" silently
means UTC: resolve the IANA zone from the /etc/localtime symlink. */ -}}
{{- $tzlink := trim (output "sh" "-c" "readlink /etc/localtime || echo UTC") -}}
{{- $tz := regexReplaceAll `^.*zoneinfo(?:\.default)?/` $tzlink "" -}}
{{- if not $tz }}{{ $tz = "UTC" }}{{ end -}}
// Glow layout: top zjstatus bar, pane frames off. `zellij -l split` gives the
// stock two-pane layout.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="file:{{ .chezmoi.homeDir }}/.config/zellij/plugins/zjstatus.wasm" {
                format_left   "{mode}#[fg={{ $accent }},bg={{ $bar }}]#[fg={{ $onaccent }},bg={{ $accent }},bold] {session} #[fg={{ $accent }},bg={{ $bar }}] {tabs}"
                format_right  "{datetime}"
                format_space  "#[bg={{ $bar }}]"
                border_enabled "false"

                datetime          "#[fg={{ $muted }},bg={{ $bar }}]󰃭 {format} "
                datetime_format   "%b %d · %H:%M"
                datetime_timezone "{{ $tz }}"

                tab_normal    "#[fg={{ $overlay }},bg={{ $bar }}]#[fg={{ $subtle }},bg={{ $overlay }}] {name} #[fg={{ $overlay }},bg={{ $bar }}] "
                tab_active    "#[fg={{ $accent }},bg={{ $bar }}]#[fg={{ $onaccent }},bg={{ $accent }},bold] {name} #[fg={{ $accent }},bg={{ $bar }}] "

                // `{session}` is a widget, not a variable in mode_* strings: the
                // session pill is composed in format_left, and mode_* render only the
                // colour-coded chip beside it.
                mode_normal        "#[fg={{ $accent }},bg={{ $bar }}]#[fg={{ $onaccent }},bg={{ $accent }},bold] 󱂬 #[fg={{ $accent }},bg={{ $bar }}] "
                mode_locked        "#[fg={{ $muted }},bg={{ $bar }}]#[fg={{ $bg }},bg={{ $muted }},bold] 󱂬 #[fg={{ $muted }},bg={{ $bar }}] "
                mode_pane          "#[fg={{ $warn }},bg={{ $bar }}]#[fg={{ $onwarn }},bg={{ $warn }},bold] 󱂬 {name} #[fg={{ $warn }},bg={{ $bar }}] "
                mode_tab           "#[fg={{ $warn }},bg={{ $bar }}]#[fg={{ $onwarn }},bg={{ $warn }},bold] 󱂬 {name} #[fg={{ $warn }},bg={{ $bar }}] "
                mode_resize        "#[fg={{ $warn }},bg={{ $bar }}]#[fg={{ $onwarn }},bg={{ $warn }},bold] 󱂬 {name} #[fg={{ $warn }},bg={{ $bar }}] "
                mode_scroll        "#[fg={{ $warn }},bg={{ $bar }}]#[fg={{ $onwarn }},bg={{ $warn }},bold] 󱂬 {name} #[fg={{ $warn }},bg={{ $bar }}] "
                mode_enter_search  "#[fg={{ $warn }},bg={{ $bar }}]#[fg={{ $onwarn }},bg={{ $warn }},bold] 󱂬 {name} #[fg={{ $warn }},bg={{ $bar }}] "
                mode_search        "#[fg={{ $warn }},bg={{ $bar }}]#[fg={{ $onwarn }},bg={{ $warn }},bold] 󱂬 {name} #[fg={{ $warn }},bg={{ $bar }}] "
                mode_rename_tab    "#[fg={{ $warn }},bg={{ $bar }}]#[fg={{ $onwarn }},bg={{ $warn }},bold] 󱂬 {name} #[fg={{ $warn }},bg={{ $bar }}] "
                mode_rename_pane   "#[fg={{ $warn }},bg={{ $bar }}]#[fg={{ $onwarn }},bg={{ $warn }},bold] 󱂬 {name} #[fg={{ $warn }},bg={{ $bar }}] "
                mode_session       "#[fg={{ $warn }},bg={{ $bar }}]#[fg={{ $onwarn }},bg={{ $warn }},bold] 󱂬 {name} #[fg={{ $warn }},bg={{ $bar }}] "
                mode_move          "#[fg={{ $warn }},bg={{ $bar }}]#[fg={{ $onwarn }},bg={{ $warn }},bold] 󱂬 {name} #[fg={{ $warn }},bg={{ $bar }}] "
                mode_prompt        "#[fg={{ $warn }},bg={{ $bar }}]#[fg={{ $onwarn }},bg={{ $warn }},bold] 󱂬 {name} #[fg={{ $warn }},bg={{ $bar }}] "
                mode_tmux          "#[fg={{ $warn }},bg={{ $bar }}]#[fg={{ $onwarn }},bg={{ $warn }},bold] 󱂬 {name} #[fg={{ $warn }},bg={{ $bar }}] "
                mode_default_to_mode "pane"
            }
        }
        children
    }
    tab name="main"
}
