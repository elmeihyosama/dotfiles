{{- $p := index .themes .theme -}}
theme "base16"
default_layout "glow"
pane_frames false
mouse_mode true
copy_on_select true

themes {
    base16 {
        fg "{{ $p.base05 }}"
        bg "{{ $p.base00 }}"
        black "{{ $p.base00 }}"
        red "{{ $p.base08 }}"
        green "{{ $p.base0B }}"
        yellow "{{ $p.base0A }}"
        blue "{{ $p.base0D }}"
        magenta "{{ $p.base0E }}"
        cyan "{{ $p.base0C }}"
        white "{{ $p.base05 }}"
        orange "{{ $p.base09 }}"
    }
}

keybinds {
    // Rename from a blank name. The default tmux-mode `,` binding keeps the
    // current name ("Tab #2") in the buffer, so typing appended to it.
    tab {
        bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }
    }
    tmux {
        bind "," { SwitchToMode "RenameTab"; TabNameInput 0; }
    }
    session {
        // Ctrl-o then f → fuzzy project→session switcher in a floating pane.
        bind "f" {
            Run "{{ .chezmoi.sourceDir }}/../scripts/sessionize.sh" {
                floating true
                close_on_exit true
            }
            SwitchToMode "Normal"
        }
    }
}
