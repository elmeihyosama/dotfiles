{{- $p := index .themes .theme -}}
{{- $on := index .on_colors .theme -}}
-- Generated by chezmoi: design tokens resolved against the active palette.
return {
  accent  = "{{ index $p .design.accent }}",
  accent2 = "{{ index $p .design.accent2 }}",
  link    = "{{ index $p .design.link }}",
  ok      = "{{ index $p .design.ok }}",
  warn    = "{{ index $p .design.warn }}",
  err     = "{{ index $p .design.err }}",
  rail    = "{{ index $p .design.rail }}",
  -- Contrast-safe foreground for text ON each accent-coloured role (base00 or
  -- base05, precomputed per theme by scripts/gen-on-colors.sh).
  on_accent  = "{{ index $on .design.accent }}",
  on_accent2 = "{{ index $on .design.accent2 }}",
  on_link    = "{{ index $on .design.link }}",
  on_warn    = "{{ index $on .design.warn }}",
  on_err     = "{{ index $on .design.err }}",
  bg      = "{{ $p.base00 }}",
  surface = "{{ $p.base01 }}",
  overlay = "{{ $p.base02 }}",
  muted   = "{{ $p.base03 }}",
  subtle  = "{{ $p.base04 }}",
  text    = "{{ $p.base05 }}",
  border  = "{{ .design.border }}",
}
