{{- $p := index .themes .theme -}}
-- Generated by chezmoi from the active base16 palette.
return {
  {
    "RRethy/base16-nvim",
    lazy = false,
    priority = 1000,
  },
  {
    "LazyVim/LazyVim",
    opts = {
      colorscheme = function()
        require("base16-colorscheme").setup({
          base00 = "{{ $p.base00 }}", base01 = "{{ $p.base01 }}",
          base02 = "{{ $p.base02 }}", base03 = "{{ $p.base03 }}",
          base04 = "{{ $p.base04 }}", base05 = "{{ $p.base05 }}",
          base06 = "{{ $p.base06 }}", base07 = "{{ $p.base07 }}",
          base08 = "{{ $p.base08 }}", base09 = "{{ $p.base09 }}",
          base0A = "{{ $p.base0A }}", base0B = "{{ $p.base0B }}",
          base0C = "{{ $p.base0C }}", base0D = "{{ $p.base0D }}",
          base0E = "{{ $p.base0E }}", base0F = "{{ $p.base0F }}",
        })
        -- Quiet-interior tweaks on top of the generated palette.
        local hl = vim.api.nvim_set_hl
        hl(0, "FloatBorder", { fg = "{{ $p.base03 }}", bg = "{{ $p.base00 }}" })
        hl(0, "SnacksIndent", { fg = "{{ $p.base02 }}" })
        hl(0, "DiagnosticVirtualTextError", { fg = "{{ $p.base08 }}", italic = true })
        hl(0, "DiagnosticVirtualTextWarn", { fg = "{{ $p.base0A }}", italic = true })
      end,
    },
  },
}
