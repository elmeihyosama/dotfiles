{{- $p := index .themes .theme -}}
# Backend: ripgrep → fd → find
if command -v rg >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND="rg --files --hidden --follow --glob '!.git'"
elif command -v fd >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND="fd --hidden --follow --exclude .git"
else
  export FZF_DEFAULT_COMMAND="find . -type f ! -path '*/.git/*'"
fi

# Theme (raw hex from active palette) + layout
export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:+$FZF_DEFAULT_OPTS }\
--height 40% --ansi --layout=reverse --border --prompt='❯ ' --pointer='▶' --marker='✓' \
--color=fg:{{ $p.base05 }},bg:{{ $p.base00 }},hl:{{ $p.base08 }} \
--color=fg+:{{ $p.base05 }},bg+:{{ $p.base01 }},hl+:{{ $p.base08 }} \
--color=info:{{ $p.base0C }},prompt:{{ index $p .design.accent }},pointer:{{ index $p .design.accent }} \
--color=marker:{{ $p.base0C }},spinner:{{ index $p .design.accent2 }},header:{{ $p.base08 }}"

# Source for the Ctrl-T (file) and Alt-C/Ctrl-O (cd) widgets
if command -v fd >/dev/null 2>&1; then
  export FZF_CTRL_T_COMMAND="fd --hidden --follow --exclude .git"
  export FZF_ALT_C_COMMAND="fd --type=d --hidden --follow --exclude .git"
fi

# Official shell integration, generated by the installed fzf (binds ^R, ^T, Alt-C).
# ^R is handed back to atuin (loaded in 35-atuin, before this file) — fzf keeps
# ^T (files) and Alt-C (cd). 40 loads after 35, so re-assert atuin's ^R here.
if command -v fzf >/dev/null 2>&1; then
  # `fzf --zsh` needs fzf >= 0.48. Older distro packages (Ubuntu 24.04 ships
  # 0.44) abort with "unknown option: --zsh" on EVERY shell start and leave the
  # widgets unbound. min_versions floors fzf so provisioning routes it to ubi,
  # but guard here too for hosts where fzf came from somewhere else.
  if _fzf_init=$(fzf --zsh 2>/dev/null); then
    eval "$_fzf_init"
  else
    print -u2 "40-fzf.zsh: fzf $(fzf --version 2>/dev/null | awk '{print $1}') lacks --zsh (need >= 0.48); ^T/Alt-C/^O unbound."
  fi
  unset _fzf_init
  if command -v atuin >/dev/null 2>&1; then
    bindkey -M viins "^R" atuin-search-viins
    bindkey -M vicmd "^R" atuin-search-vicmd
  fi
fi

# Also map Ctrl-O to the cd widget (both keymaps — vi-mode; matches the rest)
# Guarded: without the integration above the widget does not exist, and bindkey
# would silently bind ^O to nothing.
if (( ${+widgets[fzf-cd-widget]} )); then
  bindkey -M viins '^O' fzf-cd-widget
  bindkey -M vicmd '^O' fzf-cd-widget
fi

# fzf-tab styling
zstyle ':completion:*' menu no-select
zstyle ':fzf-tab:complete:*' fzf-flags --preview-window=right:50%:wrap
zstyle ':fzf-tab:*' switch-group '<' '>'
zstyle ':fzf-tab:*' show-group full
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':fzf-tab:complete:cd:*' fzf-preview \
  'eza --icons=always --color=always --group-directories-first $realpath 2>/dev/null || ls --color=always $realpath 2>/dev/null'
zstyle ':fzf-tab:complete:*:*' fzf-preview \
  'if [[ -d $realpath ]]; then eza --icons=always --color=always $realpath 2>/dev/null || ls $realpath; \
    elif [[ -f $realpath ]]; then bat --color=always --style=numbers --line-range=:300 $realpath 2>/dev/null || cat $realpath; fi'
