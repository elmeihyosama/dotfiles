{{- /* atuin: database-backed history. Owns Ctrl-R and Up-arrow. */ -}}
if command -v atuin >/dev/null 2>&1; then
  # One-time import of the existing zsh history file into atuin's DB.
  _atuin_flag="${XDG_STATE_HOME:-$HOME/.local/state}/atuin/.imported"
  if [[ ! -f $_atuin_flag ]]; then
    if atuin import auto >/dev/null 2>&1; then
      mkdir -p "${_atuin_flag:h}" && : >| "$_atuin_flag"
    fi
  fi
  unset _atuin_flag

  # Binds Ctrl-R and Up-arrow to atuin's search.
  eval "$(atuin init zsh)"

  # atuin binds `?` to its AI widget (sends the buffer to a remote service):
  # restore plain typing in insert mode and vi's search in command mode.
  bindkey -M viins '?' self-insert
  bindkey -M vicmd '?' vi-history-search-backward

  # Re-assert atuin's per-keymap Up-arrow widgets (same as its defaults in
  # v18.17.1), defensively.
  bindkey -M viins "^[[A" atuin-up-search-viins
  bindkey -M vicmd "^[[A" atuin-up-search-vicmd
  bindkey -M viins "^[OA" atuin-up-search-viins
  bindkey -M vicmd "^[OA" atuin-up-search-vicmd
fi
