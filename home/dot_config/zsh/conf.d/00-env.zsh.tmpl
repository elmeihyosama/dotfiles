# XDG base dirs
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# PATH
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

# Locale
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# Editor
export EDITOR=nvim
export VISUAL=nvim

# History
export HISTFILE="${XDG_STATE_HOME}/zsh/history"
export HISTSIZE=50000
export SAVEHIST=50000
[[ -d "${HISTFILE:h}" ]] || mkdir -p "${HISTFILE:h}"

# zsh options
setopt autocd interactivecomments
setopt autopushd pushdignoredups pushdsilent   # `cd` builds a stack; `cd -<Tab>` to revisit
setopt sharehistory histignoredups histreduceblanks \
       histexpiredupsfirst histignorespace extendedhistory

# Vi keymap, established before any plugin/tool binds keys so bindings are
# deterministic (not dependent on the EDITOR=nvim default). KEYTIMEOUT keeps
# the Esc->normal switch snappy.
bindkey -v
export KEYTIMEOUT=1

# Pager + bat-powered man pages
export PAGER='less'
export LESS='-R'
command -v bat >/dev/null 2>&1 && export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# Ripgrep config (guard: an unset-but-nonexistent path makes every `rg` error)
[[ -f "$HOME/.config/ripgrep/config" ]] && export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"

# eza: on macOS it ignores XDG and reads ~/Library/Application Support/eza
# unless EZA_CONFIG_DIR is set explicitly. Force it to our themed config.
export EZA_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/eza"

# Sessionizer project roots (from chezmoi data); expand ~ to $HOME so the
# script's `[ -d "$root" ]` checks resolve.
SESSIONIZE_ROOTS="{{ .sessionize_roots }}"; export SESSIONIZE_ROOTS="${SESSIONIZE_ROOTS//\~/$HOME}"

# Default apps
export TERMINAL="ghostty"
export BROWSER="firefox"
{{ if eq .chezmoi.os "linux" -}}
# Wayland (Linux only)
export QT_QPA_PLATFORM=wayland
export XDG_SESSION_TYPE=wayland
export MOZ_ENABLE_WAYLAND=1
{{- end }}
