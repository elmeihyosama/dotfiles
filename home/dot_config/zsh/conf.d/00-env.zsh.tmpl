# XDG base dirs
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# Unique entries: prepends (and nested shells) would stack duplicates.
typeset -U path
{{ if .shared_home -}}
# Shared-$HOME multi-arch host: this arch's binaries first; plain ~/.local/bin
# stays for arch-neutral scripts. $(uname -m) resolves per login host.
_arch="$(uname -m)"
export PATH="$HOME/.local/bin-$_arch:$HOME/.local/bin:$HOME/bin:$PATH"
export MISE_DATA_DIR="$HOME/.local/share-$_arch/mise"
# uv's dirs per-arch at runtime too, so ad-hoc `uv tool install` matches.
export XDG_BIN_HOME="$HOME/.local/bin-$_arch"
export UV_PYTHON_INSTALL_DIR="$HOME/.local/share-$_arch/uv/python"
export UV_TOOL_DIR="$HOME/.local/share-$_arch/uv/tools"
# Generated snippets bake the producing binary's absolute path: one cache root
# per arch, or the other arch gets "exec format error".
export ZSH_CACHE_DIR="$XDG_CACHE_HOME/zsh-$_arch"
unset _arch
{{- else -}}
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"
{{- end }}
# mise shims back in front: the prepends above would put ~/.local/bin ahead of
# the pinned tools. Interactive shells then get `mise activate` (49-mise).
{{ if .shared_home -}}
_mise_shims="$HOME/.local/share-$(uname -m)/mise/shims"
{{- else -}}
_mise_shims="$XDG_DATA_HOME/mise/shims"
{{- end }}
[[ -d $_mise_shims ]] && path=("$_mise_shims" ${path:#$_mise_shims})
unset _mise_shims

# Here, not in 90-local: later modules guard their init on `command -v`.
[[ -d "$HOME/.cargo/bin" ]] && export PATH="$HOME/.cargo/bin:$PATH"
[[ -d "$HOME/.local/go/bin" ]] && export PATH="$HOME/.local/go/bin:$PATH"

# Advertise zsh to child processes: on locked-down hosts the login shell stays
# /bin/bash, so this is where zsh becomes the default.
(( $+commands[zsh] )) && export SHELL="$commands[zsh]"

# Locale
{{ if eq .chezmoi.os "linux" -}}
# Minimal hosts often lack en_US.UTF-8; a missing locale spews warnings.
if locale -a 2>/dev/null | grep -qiE '^en_US\.utf-?8$'; then
  export LANG=en_US.UTF-8
  export LC_ALL=en_US.UTF-8
else
  export LANG=C.UTF-8
  export LC_ALL=C.UTF-8
fi
{{- else -}}
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
{{- end }}

# Editor
export EDITOR=nvim
export VISUAL=nvim

# History
export HISTFILE="${XDG_STATE_HOME}/zsh/history"
export HISTSIZE=50000
export SAVEHIST=50000
[[ -d "${HISTFILE:h}" ]] || mkdir -p "${HISTFILE:h}"

# zsh options
setopt autocd interactivecomments
setopt autopushd pushdignoredups pushdsilent   # `cd` builds a stack; `cd -<Tab>` to revisit
setopt sharehistory histignoredups histreduceblanks \
       histexpiredupsfirst histignorespace extendedhistory

# Vi keymap before any plugin binds keys, so bindings are deterministic.
bindkey -v
export KEYTIMEOUT=1

# Pager + bat-powered man pages
export PAGER='less'
export LESS='-R'
command -v bat >/dev/null 2>&1 && export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# Guard: a nonexistent config path makes every `rg` error.
[[ -f "$HOME/.config/ripgrep/config" ]] && export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"

# eza ignores XDG on macOS unless EZA_CONFIG_DIR is set.
export EZA_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/eza"

# Expand ~ so the script's `[ -d "$root" ]` checks resolve.
SESSIONIZE_ROOTS="{{ .sessionize_roots }}"; export SESSIONIZE_ROOTS="${SESSIONIZE_ROOTS//\~/$HOME}"

# Default apps
export TERMINAL="ghostty"
# BROWSER only where a browser can open: not over ssh{{ if eq .chezmoi.os "linux" }}, and on Linux only
# with a display (headless hosts would otherwise point tools at a dead firefox){{ end }}.
if [[ -z "$SSH_CONNECTION" && -z "$SSH_TTY" ]]{{ if eq .chezmoi.os "linux" }} && [[ -n "$WAYLAND_DISPLAY" || -n "$DISPLAY" ]]{{ end }}; then
  export BROWSER="firefox"
fi
{{ if eq .chezmoi.os "linux" -}}
if [[ -n "$WAYLAND_DISPLAY" ]]; then
  export QT_QPA_PLATFORM=wayland
  export XDG_SESSION_TYPE=wayland
  export MOZ_ENABLE_WAYLAND=1
fi
{{- end }}
