{{- /* The prompt cursor's DECSCUSR code (1/2 block, 3/4 underline, 5/6 bar;
  odd blinks) for 70-prompt.zsh. Empty, so no file, for Ghostty's own
  blinking bar. */ -}}
{{- $o := includeTemplate "prompt-settings" . | fromJson -}}
{{- if or (ne $o.cursor "bar") (eq $o.blink "off") -}}
{{ add (get (dict "block" 1 "underline" 3 "bar" 5) $o.cursor) (ternary 1 0 (eq $o.blink "off")) }}
{{ end -}}
