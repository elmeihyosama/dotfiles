{{- $p := index .themes .theme -}}
# Starship prompt: https://starship.rs/config/ — edit this file to change it
# (layout in `format`, then one table per segment). Only the colours are
# templated, so they follow the theme; `chezmoi apply` deploys it, and open
# shells pick it up on their next prompt.
"$schema" = 'https://starship.rs/config-schema.json'
add_newline = true
palette = "base16"

format = """
[╭─](rail)$hostname$directory$git_branch$git_status$jobs$nodejs$python$rust$golang$docker_context$kubernetes$fill$cmd_duration$time
[╰─](rail)$character"""

[palettes.base16]
# From the active theme (home/.chezmoidata/theme.toml); the roles are in
# home/.chezmoidata/design.toml. Use these names in any `style` below.
# structural
bg      = "{{ $p.base00 }}"
surface = "{{ $p.base01 }}"
raised  = "{{ $p.base02 }}"
muted   = "{{ $p.base03 }}"
rail    = "{{ index $p .design.rail }}"
text    = "{{ $p.base05 }}"
# design roles (chrome)
accent  = "{{ index $p .design.accent }}"
accent2 = "{{ index $p .design.accent2 }}"
link    = "{{ index $p .design.link }}"
ok      = "{{ index $p .design.ok }}"
warn    = "{{ index $p .design.warn }}"
err     = "{{ index $p .design.err }}"
# content spectrum (language segments)
red     = "{{ $p.base08 }}"
orange  = "{{ $p.base09 }}"
yellow  = "{{ $p.base0A }}"
green   = "{{ $p.base0B }}"
cyan    = "{{ $p.base0C }}"
blue    = "{{ $p.base0D }}"
magenta = "{{ $p.base0E }}"

[hostname]
ssh_only = true
ssh_symbol = " "
style = "bold orange"
format = "[$ssh_symbol$hostname]($style) "

[fill]
symbol = " "

[directory]
truncation_length = 0
truncate_to_repo = true
style = "bold accent2"
format = "[󰉋 $path]($style)[$read_only]($read_only_style) "

[git_branch]
symbol = " "
style = "link"
format = "[$symbol$branch]($style) "

[git_status]
style = "err"
format = '([$all_status$ahead_behind]($style)) '

[jobs]
symbol = "✦"
style = "warn"
format = "[$symbol $number]($style) "

[nodejs]
symbol = " "
style = "green"
format = "[$symbol($version )]($style)"

[python]
symbol = " "
style = "yellow"
format = '[$symbol(${version} )(\($virtualenv\) )]($style)'

[rust]
symbol = " "
style = "orange"
format = "[$symbol($version )]($style)"

[golang]
symbol = " "
style = "cyan"
format = "[$symbol($version )]($style)"

[docker_context]
symbol = " "
only_with_files = true
style = "muted"
format = "[$symbol$context]($style) "

[kubernetes]
symbol = "☸ "
disabled = false
style = "warn"
format = '[$symbol$context( \($namespace\))]($style) '

[cmd_duration]
min_time = 2000
style = "muted"
format = "[󱦟 $duration]($style) "

[time]
disabled = false
time_format = "%R"
style = "muted"
format = "[$time]($style)"

[character]
success_symbol = '[❯](bold accent)'
error_symbol = '[❯](bold err)'
vimcmd_symbol = '[❮](bold warn)'
