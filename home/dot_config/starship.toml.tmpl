{{- $p := index .themes .theme -}}
{{- /* Layout and colours from the prompt options (.chezmoidata/prompt.toml);
  the defaults are the lean, two-line, framed prompt. */ -}}
{{- $o := includeTemplate "prompt-settings" . | fromJson -}}
{{- $rb := eq $o.style "rainbow" -}}
{{- /* bar: one strip of bar_color, capped at each end, segments split by a
  thin divider; on surface or muted the text keeps the segment's colour,
  on a bright bar it is dark */ -}}
{{- $bar := eq $o.style "bar" -}}
{{- $bc := $o.bar_color -}}
{{- $onbar := or (eq $bc "surface") (eq $bc "muted") -}}
{{- $quiet := ternary (ternary "muted" "text" (eq $bc "surface")) "bg" $onbar -}}
{{- $nerd := eq $o.icons "nerd" -}}
{{- $two := eq $o.lines "two" -}}
{{- $split := eq $o.layout "split" -}}
{{- $frame := and $two (eq $o.frame "on") -}}
{{- $ends := get (dict "round" (list "" "") "angled" (list "" "") "slanted" (list "" "") "flat" (list "" "")) $o.separator -}}
{{- $L := index $ends 0 -}}
{{- $R := index $ends 1 -}}
{{- $D := print "[" (get (dict "round" "\ue0b5" "angled" "\ue0b1" "slanted" "\ue0bd" "flat" "│") $o.separator) "](fg:" (ternary (ternary "muted" "bg" (eq $bc "surface")) "bg" $onbar) " bg:" $bc ")" -}}
{{- /* on the right edge (split) the clock ends the line; on the left a
  space keeps it off what follows */ -}}
{{- $sp := ternary "" " " $split -}}
{{- $left := "$hostname$directory$git_branch$git_status$jobs" -}}
{{- if eq $o.langs "on" }}{{ $left = print $left "$nodejs$python$rust$golang" }}{{ end -}}
{{- $left = print $left "$docker_context$kubernetes" -}}
{{- $right := "$cmd_duration$time" -}}
{{- if $bar -}}
{{-   $left = printf "[%s](fg:%s)%s[%s](fg:%s) " $L $bc $left $R $bc -}}
{{-   if ne $o.time "off" }}{{ $right = printf "[%s](fg:%s)%s[%s](fg:%s)%s" $L $bc $right $R $bc $sp }}{{ end -}}
{{- end -}}
{{- /* block: a rainbow segment, text T on colour C between the two ends */ -}}
{{- define "block" }}[{{ .L }}](fg:{{ .c }})[ {{ .t }} ]($style)[{{ .R }}](fg:{{ .c }}){{ end -}}
"$schema" = 'https://starship.rs/config-schema.json'
add_newline = {{ eq $o.spacing "sparse" }}
palette = "base16"

{{ if $two -}}
format = """
{{ if $frame }}[╭─]({{ $o.frame_color }}){{ end }}{{ $left }}{{ if $split }}$fill{{ if ne $o.fill "space" }} {{ end }}{{ end }}{{ $right }}
{{ if $frame }}[╰─]({{ $o.frame_color }}){{ end }}$character"""
{{- else if $split -}}
format = "{{ $left }}$character"
right_format = "{{ $right }}"
{{- else -}}
format = "{{ $left }}{{ $right }}$character"
{{- end }}

[palettes.base16]
# structural
bg      = "{{ $p.base00 }}"
surface = "{{ $p.base01 }}"
muted   = "{{ $p.base03 }}"
rail    = "{{ index $p .design.rail }}"
text    = "{{ $p.base05 }}"
# design roles (chrome)
accent  = "{{ index $p .design.accent }}"
accent2 = "{{ index $p .design.accent2 }}"
link    = "{{ index $p .design.link }}"
ok      = "{{ index $p .design.ok }}"
warn    = "{{ index $p .design.warn }}"
err     = "{{ index $p .design.err }}"
# content spectrum (language segments)
red     = "{{ $p.base08 }}"
orange  = "{{ $p.base09 }}"
yellow  = "{{ $p.base0A }}"
green   = "{{ $p.base0B }}"
cyan    = "{{ $p.base0C }}"
blue    = "{{ $p.base0D }}"
magenta = "{{ $p.base0E }}"

[hostname]
ssh_only = true
ssh_symbol = "{{ if $nerd }} {{ else }}ssh {{ end }}"
{{- if $bar }}
style = "bold fg:{{ ternary "orange" "bg" $onbar }} bg:{{ $bc }}"
format = '[ $ssh_symbol$hostname ]($style){{ $D }}'
{{- else if $rb }}
style = "bold fg:bg bg:orange"
format = '{{ template "block" (dict "L" $L "R" $R "c" "orange" "t" "$ssh_symbol$hostname") }} '
{{- else }}
style = "bold orange"
format = "[$ssh_symbol$hostname]($style) "
{{- end }}

[fill]
{{- if or (eq $o.fill "space") (not (and $two $split)) }}
symbol = " "
{{- else }}
symbol = "{{ get (dict "dots" "·" "line" "─" "dashed" "╌") $o.fill }}"
style = "{{ $o.frame_color }}"
{{- end }}

[directory]
truncation_length = 0
truncate_to_repo = true
{{- if $bar }}
style = "bold fg:{{ ternary $o.dir_color "bg" $onbar }} bg:{{ $bc }}"
format = '[ {{ ternary "󰉋 " "" $nerd }}$path$read_only ]($style)'
{{- else if $rb }}
style = "bold fg:bg bg:{{ $o.dir_color }}"
format = '{{ template "block" (dict "L" $L "R" $R "c" $o.dir_color "t" (print (ternary "󰉋 " "" $nerd) "$path$read_only")) }} '
{{- else }}
style = "bold {{ $o.dir_color }}"
format = "[{{ if $nerd }}󰉋 {{ end }}$path]($style)[$read_only]($read_only_style) "
{{- end }}

[git_branch]
symbol = "{{ ternary "\ue725 " "" $nerd }}"
{{- if $bar }}
style = "bold fg:{{ ternary $o.git_color "bg" $onbar }} bg:{{ $bc }}"
format = '{{ $D }}[ $symbol$branch ]($style)'
{{- else if $rb }}
style = "bold fg:bg bg:{{ $o.git_color }}"
format = '{{ template "block" (dict "L" $L "R" $R "c" $o.git_color "t" "$symbol$branch") }} '
{{- else }}
style = "{{ $o.git_color }}"
format = "[$symbol$branch]($style) "
{{- end }}

[git_status]
{{- if $bar }}
style = "bold fg:{{ ternary "err" "bg" $onbar }} bg:{{ $bc }}"
format = '([$all_status$ahead_behind ]($style))'
{{- else if $rb }}
style = "bold fg:bg bg:err"
format = '({{ template "block" (dict "L" $L "R" $R "c" "err" "t" "$all_status$ahead_behind") }} )'
{{- else }}
style = "err"
format = '([$all_status$ahead_behind]($style)) '
{{- end }}

[jobs]
symbol = "✦"
{{- if $bar }}
style = "bold fg:{{ ternary "warn" "bg" $onbar }} bg:{{ $bc }}"
format = '{{ $D }}[ $symbol $number ]($style)'
{{- else if $rb }}
style = "bold fg:bg bg:warn"
format = '{{ template "block" (dict "L" $L "R" $R "c" "warn" "t" "$symbol $number") }} '
{{- else }}
style = "warn"
format = "[$symbol $number]($style) "
{{- end }}

[nodejs]
symbol = "{{ ternary "\ue718 " "node " $nerd }}"
{{- if $bar }}
style = "fg:{{ ternary "green" "bg" $onbar }} bg:{{ $bc }}"
format = '{{ $D }}[ $symbol($version) ]($style)'
{{- else if $rb }}
style = "bold fg:bg bg:green"
format = '{{ template "block" (dict "L" $L "R" $R "c" "green" "t" "$symbol($version)") }} '
{{- else }}
style = "green"
format = "[$symbol($version )]($style)"
{{- end }}

[python]
symbol = "{{ ternary "\ue73c " "py " $nerd }}"
{{- if $bar }}
style = "fg:{{ ternary "yellow" "bg" $onbar }} bg:{{ $bc }}"
format = '{{ $D }}[ $symbol${version}( \($virtualenv\)) ]($style)'
{{- else if $rb }}
style = "bold fg:bg bg:yellow"
format = '{{ template "block" (dict "L" $L "R" $R "c" "yellow" "t" "$symbol${version}( \\($virtualenv\\))") }} '
{{- else }}
style = "yellow"
format = '[$symbol(${version} )(\($virtualenv\) )]($style)'
{{- end }}

[rust]
symbol = "{{ ternary "\ue7a8 " "rs " $nerd }}"
{{- if $bar }}
style = "fg:{{ ternary "orange" "bg" $onbar }} bg:{{ $bc }}"
format = '{{ $D }}[ $symbol($version) ]($style)'
{{- else if $rb }}
style = "bold fg:bg bg:orange"
format = '{{ template "block" (dict "L" $L "R" $R "c" "orange" "t" "$symbol($version)") }} '
{{- else }}
style = "orange"
format = "[$symbol($version )]($style)"
{{- end }}

[golang]
symbol = "{{ ternary "\ue627 " "go " $nerd }}"
{{- if $bar }}
style = "fg:{{ ternary "cyan" "bg" $onbar }} bg:{{ $bc }}"
format = '{{ $D }}[ $symbol($version) ]($style)'
{{- else if $rb }}
style = "bold fg:bg bg:cyan"
format = '{{ template "block" (dict "L" $L "R" $R "c" "cyan" "t" "$symbol($version)") }} '
{{- else }}
style = "cyan"
format = "[$symbol($version )]($style)"
{{- end }}

[docker_context]
symbol = "{{ ternary "\uf308 " "docker " $nerd }}"
only_with_files = true
{{- if $bar }}
style = "fg:{{ $quiet }} bg:{{ $bc }}"
format = '{{ $D }}[ $symbol$context ]($style)'
{{- else if $rb }}
style = "fg:text bg:muted"
format = '{{ template "block" (dict "L" $L "R" $R "c" "muted" "t" "$symbol$context") }} '
{{- else }}
style = "muted"
format = "[$symbol$context]($style) "
{{- end }}

[kubernetes]
symbol = "{{ if $nerd }}☸ {{ else }}k8s {{ end }}"
disabled = false
{{- if $bar }}
style = "bold fg:{{ ternary "warn" "bg" $onbar }} bg:{{ $bc }}"
format = '{{ $D }}[ $symbol$context( \($namespace\)) ]($style)'
{{- else if $rb }}
style = "bold fg:bg bg:warn"
format = '{{ template "block" (dict "L" $L "R" $R "c" "warn" "t" "$symbol$context( \\($namespace\\))") }} '
{{- else }}
style = "warn"
format = '[$symbol$context( \($namespace\))]($style) '
{{- end }}

[cmd_duration]
min_time = 2000
{{- $took := ternary "󱦟 $duration" "took $duration" $nerd }}
{{- if $bar }}
style = "fg:{{ $quiet }} bg:{{ $bc }}"
{{- if eq $o.time "off" }}
format = '[{{ $L }}](fg:{{ $bc }})[ {{ $took }} ]($style)[{{ $R }}](fg:{{ $bc }}){{ $sp }}'
{{- else }}
format = '[ {{ $took }} ]($style){{ $D }}'
{{- end }}
{{- else if $rb }}
style = "fg:text bg:muted"
format = '{{ template "block" (dict "L" $L "R" $R "c" "muted" "t" $took) }} '
{{- else }}
style = "muted"
format = "[{{ $took }}]($style) "
{{- end }}

[time]
disabled = {{ eq $o.time "off" }}
time_format = "{{ ternary "%I:%M %p" "%R" (eq $o.time "12h") }}"
{{- if $bar }}
style = "fg:{{ $quiet }} bg:{{ $bc }}"
format = '[ $time ]($style)'
{{- else if $rb }}
style = "fg:text bg:muted"
format = '{{ template "block" (dict "L" $L "R" $R "c" "muted" "t" "$time") }}{{ $sp }}'
{{- else }}
style = "muted"
format = "[$time]($style){{ $sp }}"
{{- end }}

[character]
{{- /* literal strings: the $ symbol reaches starship escaped */}}
{{- $sym := get (dict "chevron" (list "❯" "❮") "arrow" (list "➜" "➜") "lambda" (list "λ" "λ") "dollar" (list "\\$" "\\$") "triangle" (list "▶" "◀")) $o.char }}
success_symbol = '[{{ index $sym 0 }}](bold {{ $o.char_color }})'
error_symbol = '[{{ index $sym 0 }}](bold err)'
vimcmd_symbol = '[{{ index $sym 1 }}](bold warn)'
