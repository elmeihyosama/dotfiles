{{- $p := index .themes .theme -}}
{{- /* Layout and colours from the prompt options (.chezmoidata/prompt.toml);
  the defaults are the lean, two-line, framed prompt. */ -}}
{{- $o := includeTemplate "prompt-settings" . | fromJson -}}
{{- $rb := eq $o.style "rainbow" -}}
{{- /* bar: segments on one strip, capped at each end, split by thin
  dividers. bar_color theme (the default) takes the strip from the theme in
  bands with dark text: A (hostname, directory) in the directory colour, G
  (git, in a repo) in the branch colour, then B (the rest, and the right
  side) on the raised base02 with each segment's colour; any other bar_color
  is one strip of that colour, where on surface, raised or muted the text
  keeps each segment's colour and on a bright one it is dark */ -}}
{{- $bar := eq $o.style "bar" -}}
{{- $bc := $o.bar_color -}}
{{- $themed := eq $bc "theme" -}}
{{- $A := ternary $o.dir_color $bc $themed -}}
{{- $G := ternary $o.git_color $bc $themed -}}
{{- $B := ternary "raised" $bc $themed -}}
{{- $onA := and (not $themed) (has $bc (list "surface" "raised" "muted")) -}}
{{- $onB := or $themed $onA -}}
{{- $quiet := ternary (ternary "muted" "text" (eq $B "surface")) "bg" $onB -}}
{{- $nerd := eq $o.icons "nerd" -}}
{{- $two := eq $o.lines "two" -}}
{{- $split := eq $o.layout "split" -}}
{{- $frame := and $two (eq $o.frame "on") -}}
{{- $shapes := dict "round" (list "\ue0b6" "\ue0b4") "angled" (list "\ue0b2" "\ue0b0") "slanted" (list "\ue0ba" "\ue0bc") "flat" (list "" "") -}}
{{- $thins := dict "round" "\ue0b5" "angled" "\ue0b1" "slanted" "\ue0bd" "flat" "│" -}}
{{- $L := index (get $shapes $o.separator) 0 -}}
{{- if ne $o.start "same" }}{{ $L = index (get $shapes $o.start) 0 }}{{ end -}}
{{- $R := index (get $shapes $o.separator) 1 -}}
{{- $thin := get $thins $o.separator -}}
{{- /* the right side's blocks or bar: their own shape, or the left's */ -}}
{{- $Lr := $L -}}
{{- $Rr := $R -}}
{{- $thinR := $thin -}}
{{- if ne $o.right_ends "same" -}}
{{-   $Lr = index (get $shapes $o.right_ends) 0 -}}
{{-   $Rr = index (get $shapes $o.right_ends) 1 -}}
{{-   $thinR = get $thins $o.right_ends -}}
{{- end -}}
{{- $DA := printf "[%s](fg:%s bg:%s)" $thin (ternary (ternary "muted" "bg" (eq $A "surface")) "bg" $onA) $A -}}
{{- $DB := printf "[%s](fg:%s bg:%s)" $thin (ternary (ternary "muted" "bg" (eq $B "surface")) "bg" $onB) $B -}}
{{- $DR := printf "[%s](fg:%s bg:%s)" $thinR (ternary (ternary "muted" "bg" (eq $B "surface")) "bg" $onB) $B -}}
{{- /* band B on the left opens with band A's end, so no divider of its own */ -}}
{{- $DL := ternary "" $DB $themed -}}
{{- /* on the right edge (split) the clock ends the line; on the left a
  space keeps it off what follows */ -}}
{{- $sp := ternary "" " " $split -}}
{{- $leftA := "$hostname$directory$git_branch$git_status" -}}
{{- $leftB := "$jobs" -}}
{{- if eq $o.langs "on" }}{{ $leftB = print $leftB "$nodejs$python$rust$golang" }}{{ end -}}
{{- $leftB = print $leftB "$docker_context$kubernetes" -}}
{{- $left := print $leftA $leftB -}}
{{- $right := "$cmd_duration$time" -}}
{{- if $bar -}}
{{-   if $themed -}}
{{- /* the directory ends into G in a repo and into B elsewhere (its
          repo_root_format); G ends into B only when git shows */ -}}
{{-     $leftA = printf "$hostname$directory($git_branch$git_status[%s](fg:%s bg:%s))" $R $G $B -}}
{{-   end -}}
{{-   $left = printf "[%s](fg:%s)%s%s[%s](fg:%s) " $L $A $leftA $leftB $R $B -}}
{{-   if ne $o.time "off" }}{{ $right = printf "[%s](fg:%s)%s[%s](fg:%s)%s" $Lr $B $right $Rr $B $sp }}{{ end -}}
{{- end -}}
{{- /* block: a rainbow segment, text T on colour C between the two ends */ -}}
{{- define "block" }}[{{ .L }}](fg:{{ .c }})[ {{ .t }} ]($style)[{{ .R }}](fg:{{ .c }}){{ end -}}
"$schema" = 'https://starship.rs/config-schema.json'
add_newline = {{ eq $o.spacing "sparse" }}
palette = "base16"

{{ if $two -}}
format = """
{{ if $frame }}[╭─]({{ $o.frame_color }}){{ end }}{{ $left }}{{ if $split }}$fill{{ if ne $o.fill "space" }} {{ end }}{{ end }}{{ $right }}
{{ if $frame }}[╰─]({{ $o.frame_color }}){{ end }}$character"""
{{- else if $split -}}
format = "{{ $left }}$character"
right_format = "{{ $right }}"
{{- else -}}
format = "{{ $left }}{{ $right }}$character"
{{- end }}

[palettes.base16]
# structural
bg      = "{{ $p.base00 }}"
surface = "{{ $p.base01 }}"
raised  = "{{ $p.base02 }}"
muted   = "{{ $p.base03 }}"
rail    = "{{ index $p .design.rail }}"
text    = "{{ $p.base05 }}"
# design roles (chrome)
accent  = "{{ index $p .design.accent }}"
accent2 = "{{ index $p .design.accent2 }}"
link    = "{{ index $p .design.link }}"
ok      = "{{ index $p .design.ok }}"
warn    = "{{ index $p .design.warn }}"
err     = "{{ index $p .design.err }}"
# content spectrum (language segments)
red     = "{{ $p.base08 }}"
orange  = "{{ $p.base09 }}"
yellow  = "{{ $p.base0A }}"
green   = "{{ $p.base0B }}"
cyan    = "{{ $p.base0C }}"
blue    = "{{ $p.base0D }}"
magenta = "{{ $p.base0E }}"

[hostname]
ssh_only = true
ssh_symbol = "{{ if $nerd }} {{ else }}ssh {{ end }}"
{{- if $bar }}
style = "bold fg:{{ ternary "orange" "bg" $onA }} bg:{{ $A }}"
format = '[ $ssh_symbol$hostname ]($style){{ $DA }}'
{{- else if $rb }}
style = "bold fg:bg bg:orange"
format = '{{ template "block" (dict "L" $L "R" $R "c" "orange" "t" "$ssh_symbol$hostname") }} '
{{- else }}
style = "bold orange"
format = "[$ssh_symbol$hostname]($style) "
{{- end }}

[fill]
{{- if or (eq $o.fill "space") (not (and $two $split)) }}
symbol = " "
{{- else }}
symbol = "{{ get (dict "dots" "·" "line" "─" "dashed" "╌") $o.fill }}"
style = "{{ $o.frame_color }}"
{{- end }}

[directory]
truncation_length = 0
truncate_to_repo = true
{{- if $bar }}
style = "bold fg:{{ ternary $o.dir_color "bg" $onA }} bg:{{ $A }}"
{{- if $themed }}
repo_root_style = "bold fg:bg bg:{{ $A }}"
format = '[ {{ ternary "󰉋 " "" $nerd }}$path$read_only ]($style)[{{ $R }}](fg:{{ $A }} bg:{{ $B }})'
repo_root_format = '[ {{ ternary "󰉋 " "" $nerd }}$before_root_path$repo_root$path$read_only ]($style)[{{ $R }}](fg:{{ $A }} bg:{{ $G }})'
{{- else }}
format = '[ {{ ternary "󰉋 " "" $nerd }}$path$read_only ]($style)'
{{- end }}
{{- else if $rb }}
style = "bold fg:bg bg:{{ $o.dir_color }}"
format = '{{ template "block" (dict "L" $L "R" $R "c" $o.dir_color "t" (print (ternary "󰉋 " "" $nerd) "$path$read_only")) }} '
{{- else }}
style = "bold {{ $o.dir_color }}"
format = "[{{ if $nerd }}󰉋 {{ end }}$path]($style)[$read_only]($read_only_style) "
{{- end }}

[git_branch]
symbol = "{{ ternary "\ue725 " "" $nerd }}"
{{- if $bar }}
style = "bold fg:{{ ternary $o.git_color "bg" $onA }} bg:{{ $G }}"
format = '{{ if not $themed }}{{ $DA }}{{ end }}[ $symbol$branch ]($style)'
{{- else if $rb }}
style = "bold fg:bg bg:{{ $o.git_color }}"
format = '{{ template "block" (dict "L" $L "R" $R "c" $o.git_color "t" "$symbol$branch") }} '
{{- else }}
style = "{{ $o.git_color }}"
format = "[$symbol$branch]($style) "
{{- end }}

[git_status]
{{- if $bar }}
style = "bold fg:{{ ternary "err" "bg" $onA }} bg:{{ $G }}"
format = '([$all_status$ahead_behind ]($style))'
{{- else if $rb }}
style = "bold fg:bg bg:err"
format = '({{ template "block" (dict "L" $L "R" $R "c" "err" "t" "$all_status$ahead_behind") }} )'
{{- else }}
style = "err"
format = '([$all_status$ahead_behind]($style)) '
{{- end }}

[jobs]
symbol = "✦"
{{- if $bar }}
style = "bold fg:{{ ternary "warn" "bg" $onB }} bg:{{ $B }}"
format = '{{ $DL }}[ $symbol $number ]($style)'
{{- else if $rb }}
style = "bold fg:bg bg:warn"
format = '{{ template "block" (dict "L" $L "R" $R "c" "warn" "t" "$symbol $number") }} '
{{- else }}
style = "warn"
format = "[$symbol $number]($style) "
{{- end }}

[nodejs]
symbol = "{{ ternary "\ue718 " "node " $nerd }}"
{{- if $bar }}
style = "fg:{{ ternary "green" "bg" $onB }} bg:{{ $B }}"
format = '{{ $DL }}[ $symbol($version) ]($style)'
{{- else if $rb }}
style = "bold fg:bg bg:green"
format = '{{ template "block" (dict "L" $L "R" $R "c" "green" "t" "$symbol($version)") }} '
{{- else }}
style = "green"
format = "[$symbol($version )]($style)"
{{- end }}

[python]
symbol = "{{ ternary "\ue73c " "py " $nerd }}"
{{- if $bar }}
style = "fg:{{ ternary "yellow" "bg" $onB }} bg:{{ $B }}"
format = '{{ $DL }}[ $symbol${version}( \($virtualenv\)) ]($style)'
{{- else if $rb }}
style = "bold fg:bg bg:yellow"
format = '{{ template "block" (dict "L" $L "R" $R "c" "yellow" "t" "$symbol${version}( \\($virtualenv\\))") }} '
{{- else }}
style = "yellow"
format = '[$symbol(${version} )(\($virtualenv\) )]($style)'
{{- end }}

[rust]
symbol = "{{ ternary "\ue7a8 " "rs " $nerd }}"
{{- if $bar }}
style = "fg:{{ ternary "orange" "bg" $onB }} bg:{{ $B }}"
format = '{{ $DL }}[ $symbol($version) ]($style)'
{{- else if $rb }}
style = "bold fg:bg bg:orange"
format = '{{ template "block" (dict "L" $L "R" $R "c" "orange" "t" "$symbol($version)") }} '
{{- else }}
style = "orange"
format = "[$symbol($version )]($style)"
{{- end }}

[golang]
symbol = "{{ ternary "\ue627 " "go " $nerd }}"
{{- if $bar }}
style = "fg:{{ ternary "cyan" "bg" $onB }} bg:{{ $B }}"
format = '{{ $DL }}[ $symbol($version) ]($style)'
{{- else if $rb }}
style = "bold fg:bg bg:cyan"
format = '{{ template "block" (dict "L" $L "R" $R "c" "cyan" "t" "$symbol($version)") }} '
{{- else }}
style = "cyan"
format = "[$symbol($version )]($style)"
{{- end }}

[docker_context]
symbol = "{{ ternary "\uf308 " "docker " $nerd }}"
only_with_files = true
{{- if $bar }}
style = "fg:{{ $quiet }} bg:{{ $B }}"
format = '{{ $DL }}[ $symbol$context ]($style)'
{{- else if $rb }}
style = "fg:text bg:muted"
format = '{{ template "block" (dict "L" $L "R" $R "c" "muted" "t" "$symbol$context") }} '
{{- else }}
style = "muted"
format = "[$symbol$context]($style) "
{{- end }}

[kubernetes]
symbol = "{{ if $nerd }}☸ {{ else }}k8s {{ end }}"
disabled = false
{{- if $bar }}
style = "bold fg:{{ ternary "warn" "bg" $onB }} bg:{{ $B }}"
format = '{{ $DL }}[ $symbol$context( \($namespace\)) ]($style)'
{{- else if $rb }}
style = "bold fg:bg bg:warn"
format = '{{ template "block" (dict "L" $L "R" $R "c" "warn" "t" "$symbol$context( \\($namespace\\))") }} '
{{- else }}
style = "warn"
format = '[$symbol$context( \($namespace\))]($style) '
{{- end }}

[cmd_duration]
min_time = 2000
{{- $took := ternary "󱦟 $duration" "took $duration" $nerd }}
{{- if $bar }}
style = "fg:{{ $quiet }} bg:{{ $B }}"
{{- if eq $o.time "off" }}
format = '[{{ $Lr }}](fg:{{ $B }})[ {{ $took }} ]($style)[{{ $Rr }}](fg:{{ $B }}){{ $sp }}'
{{- else }}
format = '[ {{ $took }} ]($style){{ $DR }}'
{{- end }}
{{- else if $rb }}
style = "fg:text bg:muted"
format = '{{ template "block" (dict "L" $Lr "R" $Rr "c" "muted" "t" $took) }} '
{{- else }}
style = "muted"
format = "[{{ $took }}]($style) "
{{- end }}

[time]
disabled = {{ eq $o.time "off" }}
time_format = "{{ ternary "%I:%M %p" "%R" (eq $o.time "12h") }}"
{{- if $bar }}
style = "fg:{{ $quiet }} bg:{{ $B }}"
format = '[ $time ]($style)'
{{- else if $rb }}
style = "fg:text bg:muted"
format = '{{ template "block" (dict "L" $Lr "R" $Rr "c" "muted" "t" "$time") }}{{ $sp }}'
{{- else }}
style = "muted"
format = "[$time]($style){{ $sp }}"
{{- end }}

[character]
{{- /* literal strings: the $ symbol reaches starship escaped */}}
{{- $sym := get (dict "chevron" (list "❯" "❮") "arrow" (list "➜" "➜") "lambda" (list "λ" "λ") "dollar" (list "\\$" "\\$") "triangle" (list "▶" "◀")) $o.char }}
success_symbol = '[{{ index $sym 0 }}](bold {{ $o.char_color }})'
error_symbol = '[{{ index $sym 0 }}](bold err)'
vimcmd_symbol = '[{{ index $sym 1 }}](bold warn)'
