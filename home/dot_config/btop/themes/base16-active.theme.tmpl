{{- $p := index .themes .theme -}}
# Rendered from the active base16 palette ({{ .theme }}) by chezmoi; switch
# with `theme <slug>`. Chrome uses design roles, content uses raw base0X slots
# (see home/.chezmoidata/design.toml).

# Empty main_bg = terminal default, so ghostty's background (and the optional
# wallpaper layer) shows through.
theme[main_bg]=""
theme[main_fg]="{{ $p.base05 }}"
theme[title]="{{ $p.base05 }}"
theme[hi_fg]="{{ index $p .design.accent }}"
theme[selected_bg]="{{ $p.base02 }}"
theme[selected_fg]="{{ $p.base06 }}"
theme[inactive_fg]="{{ $p.base03 }}"
theme[graph_text]="{{ $p.base04 }}"
theme[meter_bg]="{{ $p.base02 }}"
theme[proc_misc]="{{ index $p .design.accent2 }}"
theme[cpu_box]="{{ $p.base0D }}"
theme[mem_box]="{{ $p.base0B }}"
theme[net_box]="{{ $p.base0E }}"
theme[proc_box]="{{ $p.base0C }}"
theme[div_line]="{{ $p.base02 }}"
theme[temp_start]="{{ index $p .design.ok }}"
theme[temp_mid]="{{ index $p .design.warn }}"
theme[temp_end]="{{ index $p .design.err }}"
theme[cpu_start]="{{ index $p .design.ok }}"
theme[cpu_mid]="{{ index $p .design.warn }}"
theme[cpu_end]="{{ index $p .design.err }}"
theme[free_start]="{{ $p.base0B }}"
theme[free_mid]=""
theme[free_end]=""
theme[cached_start]="{{ $p.base0C }}"
theme[cached_mid]=""
theme[cached_end]=""
theme[available_start]="{{ $p.base0A }}"
theme[available_mid]=""
theme[available_end]=""
theme[used_start]="{{ $p.base08 }}"
theme[used_mid]=""
theme[used_end]=""
theme[download_start]="{{ $p.base0D }}"
theme[download_mid]=""
theme[download_end]=""
theme[upload_start]="{{ $p.base0E }}"
theme[upload_mid]=""
theme[upload_end]=""
theme[process_start]="{{ index $p .design.ok }}"
theme[process_mid]="{{ index $p .design.warn }}"
theme[process_end]="{{ index $p .design.err }}"
