{{- $p := index .themes .theme -}}
[user]
    name = {{ .git_name }}
    email = {{ .git_email }}

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only --line-numbers

[delta]
    navigate = true
    line-numbers = true
    syntax-theme = base16-active
    minus-style = "{{ $p.base08 }} {{ $p.base01 }}"
    minus-emph-style = "{{ index (index .on_colors .theme) "base08" }} {{ $p.base08 }}"
    plus-style = "{{ $p.base0B }} {{ $p.base01 }}"
    plus-emph-style = "{{ index (index .on_colors .theme) "base0B" }} {{ $p.base0B }}"
    hunk-header-style = "{{ index $p .design.accent }} bold"
    hunk-header-decoration-style = "{{ $p.base02 }} ul"
    file-style = "{{ index $p .design.accent2 }} bold"
    file-decoration-style = "{{ $p.base02 }} ul"
    line-numbers-minus-style = "{{ $p.base08 }}"
    line-numbers-plus-style = "{{ $p.base0B }}"
    line-numbers-zero-style = "{{ $p.base03 }}"

[credential]
{{- if eq .chezmoi.os "darwin" }}
    helper = osxkeychain
{{- else }}
    helper = cache --timeout=3600
{{- end }}

[push]
    autoSetupRemote = true
[rebase]
    autostash = true
    autosquash = true
[merge]
    autostash = true
[rerere]
    enabled = true
[branch]
    sort = -committerdate
[tag]
    sort = version:refname
[column]
    ui = auto
[fetch]
    prune = true
[diff]
    colorMoved = default
    algorithm = histogram
# Machine-local settings (safe.directory entries, work identities) live in
# config.local, which chezmoi does not manage. Absent file is silently ignored.
# Deliberately BEFORE the includeIf block below: with includes the last value
# wins, so a repo-specific identity must outrank a machine-wide one.
[include]
    path = ~/.config/git/config.local
{{ if hasKey . "personal_git_email" }}
# Per-repo identity. The [user] block at the top is this machine's default (the
# work identity on a work machine); the repos matched below use the personal one
# instead. This MUST come after [user] and [include] — with includes, the last
# value wins. `gitdir:` matches the directory and everything beneath it, and the
# trailing slash is required for that. Addresses live in chezmoi [data]
# (ansible/local.yml, git-ignored), so neither is committed; the directory list
# defaults from home/.chezmoidata/git.toml and is overridable the same way.
{{- range .personal_git_dirs }}
[includeIf "gitdir:{{ . }}"]
    path = ~/.config/git/personal
{{- end }}
{{- end }}
