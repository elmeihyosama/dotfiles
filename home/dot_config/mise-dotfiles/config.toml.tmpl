{{- /* Dotfiles-managed mise pins, apart from the user's ~/.config/mise/config.toml
(`mise use -g` writes there). mise reads this dir as its "system" scope via
MISE_SYSTEM_CONFIG_DIR, with mise.lock beside it. Install with
  MISE_GLOBAL_CONFIG_FILE=/nonexistent/mise-user.toml mise -C / install --locked
Never set `locked = true` here: it makes `mise use -g` fail.

Tools: `selected_tools` (from ansible/tasks/chezmoi.yml), else every tool with
a backend, minus native_on / missing_on / bootstrap / provided_by; an unknown
name fails the render. `mise_pins_all` (relock.sh) renders all of them. */ -}}
{{- $os := .chezmoi.os -}}
{{- $arch := ternary "arm64" "x64" (eq .chezmoi.arch "arm64") -}}
{{- $plat := printf "%s-%s" (ternary "macos" "linux" (eq $os "darwin")) $arch -}}
{{- $all := (and (hasKey . "mise_pins_all") .mise_pins_all) -}}
{{- $names := list -}}
{{- if and (hasKey . "selected_tools") (not $all) -}}
{{-   range $name := .selected_tools -}}
{{-     if not (hasKey $.tools $name) -}}
{{-       fail (printf "selected_tools: unknown tool %q (not in tools.yaml; stale since a tools.yaml change?). Refresh it: cd ansible && ansible-playbook site.yml --tags chezmoi" $name) -}}
{{-     end -}}
{{-     $names = append $names $name -}}
{{-   end -}}
{{- else -}}
{{-   range $name, $t := .tools -}}
{{-     $names = append $names $name -}}
{{-   end -}}
{{- end -}}
[tools]
{{- range $name := $names -}}
{{-   $t := index $.tools $name -}}
{{-   $backend := get $t "backend" -}}
{{-   $native := get $t "native_on" | default list -}}
{{-   $missing := get $t "missing_on" | default list -}}
{{-   if and $backend (not (get $t "bootstrap")) (not (get $t "provided_by")) (or $all (and (not (has $os $native)) (not (has $plat $missing)))) -}}
{{-     $opts := get $t "mise_options" -}}
{{-     if $opts }}
{{ $backend | quote }} = { version = {{ $t.version | quote }}{{ range $k, $v := $opts }}, {{ $k }} = {{ $v | toJson }}{{ end }} }
{{-     else }}
{{ $backend | quote }} = {{ $t.version | quote }}
{{-     end }}
{{-   end }}
{{- end }}
