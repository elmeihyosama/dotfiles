{{- /* Dotfiles-managed mise pins. NOT ~/.config/mise/config.toml: that file is
the user's (`mise use -g` writes there). mise reads this dir as its "system"
config scope via MISE_SYSTEM_CONFIG_DIR=$HOME/.config/mise-dotfiles (set in
.zshenv/.bashrc/.bash_profile, Raycast scripts and Ansible), and the lock lives
next to it as mise.lock. Install with
  MISE_GLOBAL_CONFIG_FILE=/nonexistent/mise-user.toml mise -C / install --locked
Never set `locked = true` in [settings] here: it makes `mise use -g` fail.

Tool set: `selected_tools` (written by ansible/tasks/chezmoi.yml from
scripts/select-tools.sh) or, when absent, every tool with a backend. Either way
tools native on this OS, bootstrap tools (mise itself) and provided_by tools
are skipped. `mise_pins_all = true` (scripts/relock.sh) renders every backend
tool regardless of OS so the shipped lock covers them all. */ -}}
{{- $os := .chezmoi.os -}}
{{- $all := (and (hasKey . "mise_pins_all") .mise_pins_all) -}}
{{- $names := list -}}
{{- if hasKey . "selected_tools" -}}
{{-   $names = .selected_tools -}}
{{- else -}}
{{-   range $name, $t := .tools -}}
{{-     $names = append $names $name -}}
{{-   end -}}
{{- end -}}
{{- if $all -}}
{{-   $names = list -}}
{{-   range $name, $t := .tools -}}
{{-     $names = append $names $name -}}
{{-   end -}}
{{- end -}}
[tools]
{{ range $name := $names -}}
{{-   $t := index $.tools $name -}}
{{-   $backend := get $t "backend" -}}
{{-   $native := get $t "native_on" | default list -}}
{{-   if and $backend (not (get $t "bootstrap")) (not (get $t "provided_by")) (or $all (not (has $os $native))) -}}
{{-     $opts := get $t "mise_options" -}}
{{-     if $opts }}
{{ $backend | quote }} = { version = {{ $t.version | quote }}{{ range $k, $v := $opts }}, {{ $k }} = {{ $v | toJson }}{{ end }} }
{{-     else }}
{{ $backend | quote }} = {{ $t.version | quote }}
{{-     end }}
{{-   end }}
{{- end }}
