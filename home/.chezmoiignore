# Machine-local secrets/overrides, managed by hand.
.config/zsh/local.zsh

# LazyVim rewrites this at runtime. lazy-lock.json is NOT ignored: it is a
# symlink into the repo so lockfile updates are tracked.
.config/nvim/lazyvim.json

# ~/Library is macOS only.
{{ if ne .chezmoi.os "darwin" }}
Library
{{ end }}

# Only with personal_git_email set.
{{ if not (hasKey . "personal_git_email") }}
.config/git/personal
{{ end }}

# zellij's permission cache is under ~/Library/Caches on macOS; one renders.
{{ if eq .chezmoi.os "darwin" }}
.cache/zellij
{{ end }}

# Only with signing_key set.
{{ if not (get . "signing_key") }}
.config/git/allowed_signers
{{ end }}
