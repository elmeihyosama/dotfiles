# mise reads the dotfiles pins/lock from here (bash never reads .zshenv).
export MISE_SYSTEM_CONFIG_DIR="$HOME/.config/mise-dotfiles"
# Login bash reads this, not ~/.bashrc: source it so its config (and the
# no-sudo jump into zsh) runs on login on distros whose ~/.profile doesn't.
[ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc"
